{
  "schemaVersion": 1,
  "id": "skybatuhan",
  "version": "${version}",
  "name": "SkyBatuhan",
  "description": "A Skyblock mode that brings randomly generated features into the game.",
  "authors": [
    "Lightre",
    "Peregrints"
  ],
  "contact": {
    "sources": "https://github.com/Lightre/skybatuhan",
    "issues": "https://github.com/Lightre/skybatuhan/issues"
  },
  "license": "GPL-3.0-only",
  "icon": "assets/skybatuhan/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.lightre.skybatuhan.SkyBatuhan"
    ],
    "modmenu": [
      "com.lightre.skybatuhan.compat.ModMenuIntegration"
    ]
  },
  "mixins": [
    "skybatuhan.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": ">=${modmenu_version}"
