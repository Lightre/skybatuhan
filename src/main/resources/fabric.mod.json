  "name": "SkyBatuhan",
  "description": "A Skyblock mode that brings randomly generated features into the game.",
  "authors": [
    "Lightre", "Peregrints"
  ],
  "contact": {
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "ARR",
  "icon": "assets/skybatuhan/icon.png",
  "environment": "client",
  "entrypoints": {
